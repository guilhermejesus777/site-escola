# Banco de dados (PostgreSQL no Neon)
# 1) Crie uma conta grátis em https://neon.com e um projeto/db
# 2) Copie a connection string e cole aqui:
DATABASE_URL="postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require"

# Senha mestra de acesso do app (NÃO é a senha do Google).
# As senhas normais são individuais e ficam no banco (tabela `senhas`),
# cadastradas em Configurações → Senhas de acesso. Esta senha mestra serve
# apenas como bootstrap para professores que ainda não têm senha individual.
# Recomendado: gere um hash com  npm run senha:hash -- "sua-senha"
# e cole o resultado em APP_LOGIN_PASSWORD_HASH.
# No desenvolvimento, se nenhuma das duas existir, vale "cepk2026" (só testes).
APP_LOGIN_PASSWORD_HASH="scrypt$sal$hash"
# APP_LOGIN_PASSWORD="troque-esta-senha"

# Chave que assina o cookie de sessão (mínimo de 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Se ficar vazia, o servidor gera uma chave temporária e as sessões caem ao reiniciar.
SESSION_SECRET="cole-uma-chave-aleatoria-bem-longa-aqui"

# Login com Google (opcional; alternativa ao e-mail + senha)
# 1) Crie um projeto em https://console.cloud.google.com
# 2) Ative a API "Google Identity Services"
# 3) Crie um OAuth 2.0 Client ID do tipo "Web application"
# 4) Adicione as origens autorizadas:
#    http://localhost:3000 e https://SEU-SITE.onrender.com
# 5) Cole o Client ID abaixo (e também no Render, nas variáveis de ambiente):
NEXT_PUBLIC_GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
