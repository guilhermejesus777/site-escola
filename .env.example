# Banco de dados (PostgreSQL no Neon)
# 1) Crie uma conta grátis em https://neon.com e um projeto/db
# 2) Copie a connection string e cole aqui:
DATABASE_URL="postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require"

# Login com Google (obrigatório para entrar no app)
# 1) Crie um projeto em https://console.cloud.google.com
# 2) Ative a API "Google Identity Services"
# 3) Crie um OAuth 2.0 Client ID do tipo "Web application"
# 4) Adicione as origens autorizadas:
#    http://localhost:3000 e https://SEU-SITE.onrender.com
# 5) Cole o Client ID abaixo (e também no Render, nas variáveis de ambiente):
NEXT_PUBLIC_GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
